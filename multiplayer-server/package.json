{
  "name": "@big-cruise/multiplayer-server",
  "private": true,
  "version": "0.1.0",
  "description": "Authoritative Colyseus room server for BIG CRUISE",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "colyseus": "^0.16.0",
    "@colyseus/ws-transport": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
